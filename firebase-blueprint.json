{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profile accounts connected via Google Auth or phone credentials",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "patients": {
      "title": "Patients",
      "description": "Patient medical profile details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "conditions": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name"]
    },
    "appointments": {
      "title": "Appointments",
      "description": "Clinical and virtual consultations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "patientId", "doctorName", "date", "time"]
    },
    "records": {
      "title": "Records",
      "description": "Diagnostic and medical test records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "title": { "type": "string" },
        "doctorName": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "date"]
    }
  }
}
