# Cloudflare Pages / Workers local environment variables (.dev.vars)
# Copy this file to .dev.vars for local testing with `wrangler pages dev`

# Google Gemini API key for AI features (Required)
GEMINI_API_KEY="your_gemini_api_key_here"

# (Optional) Android SMS Gateway API configuration
# SMS_GATEWAY_API_KEY="your_sms_gateway_api_key"
# SMS_GATEWAY_DEVICE_ID="your_device_id"

# (Optional) Textlocal SMS Gateway configuration
# TEXTLOCAL_API_KEY="your_textlocal_api_key"
# TEXTLOCAL_SENDER="TXTLCL"
